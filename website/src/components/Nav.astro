---
const APP_URL = "https://crm.strategee.us";
---

<nav class="fixed top-0 inset-x-0 z-50 bg-white/80 backdrop-blur-xl border-b border-gray-100 h-16 flex items-center">
  <div class="max-w-7xl mx-auto px-6 w-full flex items-center justify-between">
    <a href="/" class="text-xl font-extrabold text-brand-800 tracking-tight"><img src="/logo.svg" alt="Smartee" class="h-6" /></a>
    <div class="hidden md:flex items-center gap-8 text-sm text-gray-600">
      <a href="#features" class="hover:text-gray-900 transition-colors">Funcionalidades</a>
      <a href="#use-cases" class="hover:text-gray-900 transition-colors">Casos de uso</a>
      <a href="#testimonials" class="hover:text-gray-900 transition-colors">Testimonios</a>
      <a href="#pricing" class="hover:text-gray-900 transition-colors">Precios</a>
      <a href={`${APP_URL}/api-reference`} class="hover:text-gray-900 transition-colors">API</a>
    </div>
    <div class="flex items-center gap-3">
      <a href={`${APP_URL}/login`} class="text-sm text-gray-700 hover:text-gray-900 font-medium px-4 py-2 rounded-lg transition-colors">Iniciar sesión</a>
      <a href={`${APP_URL}/login`} class="text-sm text-white bg-brand-800 hover:bg-brand-700 font-medium px-5 py-2.5 rounded-lg transition-colors">Solicitar demo</a>
    </div>
  </div>
</nav>
