---
const APP_URL = "https://crm.strategee.us";
---

<footer class="border-t border-gray-200 py-12 px-6 bg-gray-50">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div>
        <p class="text-xl font-extrabold text-brand-800 tracking-tight mb-4">smartee</p>
        <p class="text-xs text-gray-500 leading-relaxed">Plataforma de comunicación empresarial para equipos que necesitan escalar.</p>
      </div>
      <div>
        <h4 class="text-xs font-semibold text-gray-900 uppercase tracking-wide mb-3">Producto</h4>
        <ul class="space-y-2 text-sm text-gray-600">
          <li><a href="#features" class="hover:text-gray-900">Funcionalidades</a></li>
          <li><a href={`${APP_URL}/api-reference`} class="hover:text-gray-900">API Reference</a></li>
          <li><a href="#pricing" class="hover:text-gray-900">Precios</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs font-semibold text-gray-900 uppercase tracking-wide mb-3">Empresa</h4>
        <ul class="space-y-2 text-sm text-gray-600">
          <li><a href="#testimonials" class="hover:text-gray-900">Clientes</a></li>
          <li><a href="#" class="hover:text-gray-900">Sobre nosotros</a></li>
          <li><a href="#" class="hover:text-gray-900">Contacto</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs font-semibold text-gray-900 uppercase tracking-wide mb-3">Legal</h4>
        <ul class="space-y-2 text-sm text-gray-600">
          <li><a href={`${APP_URL}/privacy`} class="hover:text-gray-900">Privacidad</a></li>
          <li><a href={`${APP_URL}/terms`} class="hover:text-gray-900">Términos</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 pt-6 border-t border-gray-200 flex items-center justify-between">
      <p class="text-xs text-gray-400">© 2026 Smartee. Todos los derechos reservados.</p>
      <p class="text-xs text-gray-500">soporte@strategee.us</p>
    </div>
  </div>
</footer>
