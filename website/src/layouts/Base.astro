---
interface Props {
  title?: string;
  description?: string;
}

const { title = "Smartee | Reach further, connect better", description = "Plataforma de comunicación empresarial. Centraliza WhatsApp, SMS, email y llamadas. Gestiona contactos, campañas masivas y conecta con tu API." } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="CRM, WhatsApp Business, comunicación empresarial, campañas masivas, API, contactos, omnicanal">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://smartee.strategee.us">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="font-[Plus_Jakarta_Sans] text-gray-900 antialiased">
  <slot />
</body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
