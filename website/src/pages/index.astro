---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const APP_URL = "https://crm.strategee.us";
---

<Base>
  <Nav />

  <!-- Hero -->
  <section class="pt-36 pb-24 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-brand-600 mb-4 uppercase tracking-wider">Infraestructura de comunicación empresarial</p>
        <h1 class="text-5xl md:text-[64px] font-extrabold text-gray-900 leading-[1.05] tracking-tight">
          Comunicación masiva con precisión quirúrgica
        </h1>
        <p class="text-lg text-gray-600 mt-8 leading-relaxed max-w-2xl">
          Motor de segmentación avanzado, ETL integrado y orquestación omnicanal para operaciones
          que manejan millones de contactos y equipos distribuidos. Construido para escala empresarial.
        </p>
        <div class="flex items-center gap-4 mt-10 flex-wrap">
          <a href={`${APP_URL}/login`} class="inline-flex items-center gap-2 text-sm font-semibold text-white bg-brand-800 hover:bg-brand-700 px-7 py-3.5 rounded-xl transition-colors">
            Solicitar demo
          </a>
          <a href={`${APP_URL}/api-reference`} class="inline-flex items-center gap-2 text-sm font-semibold text-gray-700 border border-gray-300 hover:border-gray-400 px-7 py-3.5 rounded-xl transition-colors">
            Ver documentación API
          </a>
        </div>
        <p class="text-xs text-gray-400 mt-6">Implementación en menos de 48 horas · Sin contratos de permanencia · SLA empresarial</p>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="py-14 border-y border-gray-100 bg-gray-50/50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-8 text-center">
        <div><p class="text-3xl font-extrabold text-gray-900">99.99%</p><p class="text-xs text-gray-500 mt-1">SLA de disponibilidad</p></div>
        <div><p class="text-3xl font-extrabold text-gray-900">50M+</p><p class="text-xs text-gray-500 mt-1">Mensajes procesados/mes</p></div>
        <div><p class="text-3xl font-extrabold text-gray-900">&lt;150ms</p><p class="text-xs text-gray-500 mt-1">Latencia promedio API</p></div>
        <div><p class="text-3xl font-extrabold text-gray-900">10M+</p><p class="text-xs text-gray-500 mt-1">Contactos gestionados</p></div>
        <div><p class="text-3xl font-extrabold text-gray-900">∞</p><p class="text-xs text-gray-500 mt-1">Campos personalizados</p></div>
      </div>
    </div>
  </section>

  <!-- Core Capabilities -->
  <section id="features" class="py-28 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-20">
        <p class="text-xs font-semibold text-brand-600 mb-3 uppercase tracking-wider">Capacidades core</p>
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900">Ingeniería de datos aplicada a comunicación</h2>
        <p class="text-gray-600 mt-4 text-base">No es un CRM genérico. Es infraestructura de comunicación diseñada para volumen, complejidad y equipos distribuidos.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="p-7 rounded-2xl border border-gray-200 hover:border-brand-200 transition-all">
          <div class="text-2xl mb-4">⚡</div>
          <h3 class="text-base font-bold text-gray-900 mb-2">Motor de segmentación</h3>
          <p class="text-sm text-gray-600 leading-relaxed">Segmentos dinámicos con condiciones compuestas (AND/OR), scoring, campos custom y filtros sobre datos JSON. Ejecuta sobre millones de registros en segundos.</p>
        </div>
        <div class="p-7 rounded-2xl border border-gray-200 hover:border-brand-200 transition-all">
          <div class="text-2xl mb-4">🔄</div>
          <h3 class="text-base font-bold text-gray-900 mb-2">ETL & transformación de datos</h3>
          <p class="text-sm text-gray-600 leading-relaxed">Importación masiva con mapeo inteligente, deduplicación, validación por reglas y upsert automático. Procesa archivos de 500K+ registros sin degradación.</p>
        </div>
        <div class="p-7 rounded-2xl border border-gray-200 hover:border-brand-200 transition-all">
          <div class="text-2xl mb-4">📡</div>
          <h3 class="text-base font-bold text-gray-900 mb-2">Orquestación omnicanal</h3>
          <p class="text-sm text-gray-600 leading-relaxed">WhatsApp Cloud API, SMS, llamadas automatizadas y email desde un solo pipeline. Enrutamiento inteligente por canal preferido del contacto.</p>
        </div>
        <div class="p-7 rounded-2xl border border-gray-200 hover:border-brand-200 transition-all">
          <div class="text-2xl mb-4">👥</div>
          <h3 class="text-base font-bold text-gray-900 mb-2">Multi-equipo y multi-tenant</h3>
          <p class="text-sm text-gray-600 leading-relaxed">Cuentas aisladas con roles granulares (admin/agente), equipos por bandeja, colaboración en tiempo real y auditoría completa de acciones.</p>
        </div>
        <div class="p-7 rounded-2xl border border-gray-200 hover:border-brand-200 transition-all">
          <div class="text-2xl mb-4">🔌</div>
          <h3 class="text-base font-bold text-gray-900 mb-2">API REST v1 + Webhooks</h3>
          <p class="text-sm text-gray-600 leading-relaxed">API documentada con autenticación por token, permisos por rol y rate limiting. Webhooks en tiempo real para cada evento del sistema.</p>
        </div>
        <div class="p-7 rounded-2xl border border-gray-200 hover:border-brand-200 transition-all">
          <div class="text-2xl mb-4">📊</div>
          <h3 class="text-base font-bold text-gray-900 mb-2">Campañas con ejecución distribuida</h3>
          <p class="text-sm text-gray-600 leading-relaxed">Workers paralelos con colas BullMQ, scheduling recurrente, throttling por canal y reportes de entrega en tiempo real vía WebSocket.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Data Pipeline Section -->
  <section class="py-28 px-6 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-xs font-semibold text-brand-600 mb-3 uppercase tracking-wider">Pipeline de datos</p>
          <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight">Adiós hojas de cálculo.<br/>Hola transformación real.</h2>
          <p class="text-gray-600 mt-6 leading-relaxed">
            Tu equipo no debería perder tiempo limpiando datos manualmente. Nuestro ETL procesa,
            valida, deduplica y enriquece tu base de contactos automáticamente.
          </p>
          <ul class="mt-8 space-y-4">
            <li class="flex items-start gap-3">
              <span class="h-6 w-6 rounded-full bg-green-100 flex items-center justify-center shrink-0 mt-0.5"><svg class="h-3.5 w-3.5 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></span>
              <div><p class="text-sm font-semibold text-gray-900">Importación masiva con mapeo visual</p><p class="text-xs text-gray-500 mt-0.5">CSV, Excel, JSON. Mapea columnas a campos del sistema o crea campos custom al vuelo.</p></div>
            </li>
            <li class="flex items-start gap-3">
              <span class="h-6 w-6 rounded-full bg-green-100 flex items-center justify-center shrink-0 mt-0.5"><svg class="h-3.5 w-3.5 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></span>
              <div><p class="text-sm font-semibold text-gray-900">Deduplicación inteligente</p><p class="text-xs text-gray-500 mt-0.5">Match por teléfono, email, documento u cualquier campo. Merge automático sin perder datos.</p></div>
            </li>
            <li class="flex items-start gap-3">
              <span class="h-6 w-6 rounded-full bg-green-100 flex items-center justify-center shrink-0 mt-0.5"><svg class="h-3.5 w-3.5 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></span>
              <div><p class="text-sm font-semibold text-gray-900">Validación por reglas</p><p class="text-xs text-gray-500 mt-0.5">Formatos de teléfono, emails válidos, campos obligatorios y reglas custom por tenant.</p></div>
            </li>
            <li class="flex items-start gap-3">
              <span class="h-6 w-6 rounded-full bg-green-100 flex items-center justify-center shrink-0 mt-0.5"><svg class="h-3.5 w-3.5 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg></span>
              <div><p class="text-sm font-semibold text-gray-900">Schema dinámico por cuenta</p><p class="text-xs text-gray-500 mt-0.5">Cada tenant define sus propios campos, validaciones y agrupaciones sin tocar código.</p></div>
            </li>
          </ul>
        </div>
        <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
          <div class="bg-gray-900 rounded-xl p-5 font-mono text-xs text-green-400 leading-relaxed overflow-x-auto">
            <p class="text-gray-500">// Importación de 500K contactos con deduplicación</p>
            <p class="mt-2"><span class="text-blue-400">POST</span> /api/v1/supergiros/etl/import</p>
            <p class="text-gray-500 mt-3">{"{"}</p>
            <p class="pl-4">"file": "clientes_agosto_2026.csv",</p>
            <p class="pl-4">"matchField": "documentNumber",</p>
            <p class="pl-4">"strategy": "upsert",</p>
            <p class="pl-4">"validations": {"{"}</p>
            <p class="pl-8">"phone": {"{"} "format": "colombian_mobile" {"}"},</p>
            <p class="pl-8">"email": {"{"} "required": true, "valid": true {"}"}</p>
            <p class="pl-4">{"}"},</p>
            <p class="pl-4">"onDuplicate": "merge_non_null"</p>
            <p>{"}"}</p>
            <p class="mt-3 text-gray-500">// Resultado en 4.2 segundos</p>
            <p>{"{"} "processed": 523841, "created": 89420,</p>
            <p class="pl-2">"updated": 434421, "skipped": 0 {"}"}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Segmentation Engine -->
  <section id="use-cases" class="py-28 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="order-2 lg:order-1 bg-white rounded-2xl border border-gray-200 p-6 shadow-sm">
          <div class="bg-gray-900 rounded-xl p-5 font-mono text-xs text-green-400 leading-relaxed overflow-x-auto">
            <p class="text-gray-500">// Segmento: VIPs en Bogotá con score > 70</p>
            <p class="mt-2"><span class="text-blue-400">POST</span> /api/v1/supergiros/campaigns/preview</p>
            <p class="text-gray-500 mt-3">{"{"}</p>
            <p class="pl-4">"segments": [{"{"}</p>
            <p class="pl-8">"logic": "AND",</p>
            <p class="pl-8">"conditions": [</p>
            <p class="pl-12">{"{"} "field": "tags", "operator": "contains", "value": "vip" {"}"},</p>
            <p class="pl-12">{"{"} "field": "city", "operator": "equals", "value": "Bogotá" {"}"},</p>
            <p class="pl-12">{"{"} "field": "score", "operator": "gte", "value": 70 {"}"},</p>
            <p class="pl-12">{"{"} "field": "optInWhatsapp", "operator": "equals", "value": true {"}"}</p>
            <p class="pl-8">]</p>
            <p class="pl-4">{"}"}]</p>
            <p>{"}"}</p>
            <p class="mt-3 text-gray-500">// 12,847 contactos coinciden</p>
            <p>{"{"} "matched": 12847, "channels": {"{"}</p>
            <p class="pl-2">"whatsapp": 11203, "sms": 1644 {"}"} {"}"}</p>
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <p class="text-xs font-semibold text-brand-600 mb-3 uppercase tracking-wider">Segmentación</p>
          <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 leading-tight">Segmentos que se construyen con lógica, no con suerte</h2>
          <p class="text-gray-600 mt-6 leading-relaxed">
            Condiciones compuestas sobre cualquier campo del sistema o custom. Combina datos demográficos,
            comportamiento, scoring y opt-in para alcanzar exactamente a quien necesitas.
          </p>
          <ul class="mt-8 space-y-3">
            <li class="flex items-center gap-3 text-sm text-gray-700"><span class="h-2 w-2 rounded-full bg-brand-600 shrink-0"></span>Operadores: equals, contains, gte, lte, between, in, not_in</li>
            <li class="flex items-center gap-3 text-sm text-gray-700"><span class="h-2 w-2 rounded-full bg-brand-600 shrink-0"></span>Lógica: AND/OR entre grupos de condiciones</li>
            <li class="flex items-center gap-3 text-sm text-gray-700"><span class="h-2 w-2 rounded-full bg-brand-600 shrink-0"></span>Campos: sistema + custom (JSONB) + tags + scoring</li>
            <li class="flex items-center gap-3 text-sm text-gray-700"><span class="h-2 w-2 rounded-full bg-brand-600 shrink-0"></span>Preview instantáneo antes de ejecutar</li>
            <li class="flex items-center gap-3 text-sm text-gray-700"><span class="h-2 w-2 rounded-full bg-brand-600 shrink-0"></span>Listas estáticas + segmentos dinámicos combinados</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Architecture -->
  <section class="py-28 px-6 bg-brand-900 text-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <p class="text-xs font-semibold text-brand-300 mb-3 uppercase tracking-wider">Arquitectura</p>
        <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">Construido para no fallar a escala</h2>
        <p class="text-brand-200 mt-4">Stack moderno, colas distribuidas y aislamiento por tenant. Sin single points of failure.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white/5 border border-white/10 rounded-xl p-6">
          <p class="text-sm font-bold text-white mb-2">NestJS + TypeORM</p>
          <p class="text-xs text-brand-200 leading-relaxed">Backend tipado con inyección de dependencias, guards modulares y validación automática.</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-6">
          <p class="text-sm font-bold text-white mb-2">PostgreSQL + JSONB</p>
          <p class="text-xs text-brand-200 leading-relaxed">Datos relacionales con flexibilidad de schema dinámico. Índices optimizados para queries de segmentación.</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-6">
          <p class="text-sm font-bold text-white mb-2">Redis + BullMQ</p>
          <p class="text-xs text-brand-200 leading-relaxed">Colas de trabajo distribuidas para campañas masivas. Workers paralelos con retry y dead letter queue.</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-xl p-6">
          <p class="text-sm font-bold text-white mb-2">WebSocket + Events</p>
          <p class="text-xs text-brand-200 leading-relaxed">Updates en tiempo real para dashboards, conversaciones y progreso de campañas sin polling.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section id="testimonials" class="py-28 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="text-xs font-semibold text-brand-600 mb-3 uppercase tracking-wider">Casos de éxito</p>
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900">Operaciones que confían en Smartee</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-gray-50 p-7 rounded-2xl border border-gray-100">
          <div class="flex gap-1 mb-4">
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
          </div>
          <p class="text-sm text-gray-700 leading-relaxed mb-5 italic">"Procesamos 2 millones de notificaciones mensuales con Smartee. El motor de segmentación nos permite alcanzar solo a clientes relevantes, reduciendo costos un 60%."</p>
          <p class="text-sm font-semibold text-gray-900">Carlos Mendoza</p>
          <p class="text-xs text-gray-500">Director de Operaciones · SuperGiros</p>
          <p class="text-[10px] text-gray-400 mt-1">+2M contactos · 4 equipos · 3 canales</p>
        </div>
        <div class="bg-gray-50 p-7 rounded-2xl border border-gray-100">
          <div class="flex gap-1 mb-4">
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
          </div>
          <p class="text-sm text-gray-700 leading-relaxed mb-5 italic">"Integramos la API con nuestro core bancario en 3 días. La documentación es impecable y el soporte técnico entiende nuestro negocio."</p>
          <p class="text-sm font-semibold text-gray-900">Andrea López</p>
          <p class="text-xs text-gray-500">CTO · Grupo Financiero del Valle</p>
          <p class="text-[10px] text-gray-400 mt-1">800K contactos · Integración API · Multi-sucursal</p>
        </div>
        <div class="bg-gray-50 p-7 rounded-2xl border border-gray-100">
          <div class="flex gap-1 mb-4">
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26"/></svg>
          </div>
          <p class="text-sm text-gray-700 leading-relaxed mb-5 italic">"Migramos desde una solución legacy que no escalaba. Con Smartee manejamos 15 equipos en 6 ciudades sin problemas de rendimiento."</p>
          <p class="text-sm font-semibold text-gray-900">Roberto Sánchez</p>
          <p class="text-xs text-gray-500">Gerente de Tecnología · Redes & Servicios</p>
          <p class="text-[10px] text-gray-400 mt-1">500K contactos · 15 equipos · 6 ciudades</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-28 px-6 bg-gray-50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="text-xs font-semibold text-brand-600 mb-3 uppercase tracking-wider">Planes</p>
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900">Precio justo para operaciones serias</h2>
        <p class="text-gray-600 mt-4">Basado en créditos de envío. Sin costos ocultos. Escala sin fricciones.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="bg-white rounded-2xl border border-gray-200 p-8">
          <h3 class="text-lg font-bold text-gray-900">Growth</h3>
          <p class="text-sm text-gray-500 mt-1">Hasta 50K contactos</p>
          <div class="mt-6"><span class="text-4xl font-extrabold text-gray-900">$299</span><span class="text-sm text-gray-500">/mes</span></div>
